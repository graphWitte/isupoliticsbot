// Квест-борд медиа-отдела.
//
// Главное решение модели: задача НЕ обязана висеть на мероприятии.
// Съёмка концерта и мем в понедельник — одна сущность Task,
// различаются полем kind и наличием eventId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ЛЮДИ ============

enum Role {
  MEMBER  // исполнитель: берёт квесты и сдаёт
  CURATOR // ты: создаёшь, раздаёшь, принимаешь
  ADMIN   // руководство внеучебки: ставит задачи, видит всё
}

enum Skill {
  PHOTO  // фотограф
  VIDEO  // видеограф
  EDIT   // монтаж
  DESIGN // дизайн, макеты
  COPY   // тексты
  SMM    // сторис, ведение площадок
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String
  lastName   String?
  photoUrl   String?
  role       Role     @default(MEMBER)
  skills     Skill[]
  points     Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  assignedTasks Task[]       @relation("assignee")
  authoredTasks Task[]       @relation("author")
  submissions   Submission[] @relation("submitter")
  reviewed      Submission[] @relation("reviewer")
  actions       TaskEvent[]  @relation("actor")
  pointEntries  PointEntry[]
  loginCodes    LoginCode[]
  sessions      Session[]

  @@index([role])
  @@index([active])
}

// ============ МЕРОПРИЯТИЯ ============

// Контейнер квестов. Создал событие -> раскатал пачку задач из шаблона.
model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  tasks Task[]

  @@index([startsAt])
  @@index([archived])
}

// ============ КВЕСТЫ ============

enum TaskKind {
  EVENT   // привязан к моменту: съёмка, эфир. Просрочил — работа потеряна навсегда
  CONTENT // пост, мем, рубрика. Дедлайн мягкий, можно взять из пула
  ORG     // организационное: созвон, смета, согласование
}

enum TaskStatus {
  DRAFT     // черновик, в чат не улетел
  OPEN      // висит на доске, можно взять
  CLAIMED   // кто-то взял
  SUBMITTED // сдан, ждёт твоей приёмки
  REVISION  // вернул на доработку
  DONE
  CANCELLED
  EXPIRED   // никто не взял до claimBy -> эскалация куратору
}

model Task {
  id       String     @id @default(cuid())
  title    String
  brief    String? // что конкретно надо сделать, в свободной форме
  kind     TaskKind   @default(CONTENT)
  status   TaskStatus @default(DRAFT)
  priority Int        @default(0)

  // НЕОБЯЗАТЕЛЬНАЯ связь: посты и мемы живут без мероприятия
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  skill  Skill? // кому подсвечивать в первую очередь
  points Int    @default(10)

  // Два РАЗНЫХ дедлайна — в этом вся квест-механика
  claimBy DateTime? // до когда надо ВЗЯТЬ (иначе EXPIRED + пинг куратору)
  dueAt   DateTime? // до когда надо СДАТЬ

  assigneeId String?
  assignee   User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  claimedAt  DateTime?

  // Денормализовано ради аналитики: «время до захвата» = claimedAt - publishedAt
  // — главная метрика продукта, гонять ради неё журнал на каждый график дорого.
  publishedAt DateTime?
  doneAt      DateTime?

  authorId String
  author   User   @relation("author", fields: [authorId], references: [id])

  // Карточка в чате отдела — бот редактирует её при смене статуса
  chatId    BigInt?
  messageId Int?

  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  submissions Submission[]
  log         TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, kind])
  @@index([assigneeId])
  @@index([eventId])
  @@index([dueAt])
  @@index([claimBy])
}

// ============ ШАБЛОНЫ ============

// Набор ролей под тип мероприятия: «Концерт» = фото + видео + сторис + пост-отчёт
model TemplatePack {
  id        String         @id @default(cuid())
  title     String
  items     TaskTemplate[]
  createdAt DateTime       @default(now())
}

model TaskTemplate {
  id     String   @id @default(cuid())
  title  String
  brief  String?
  kind   TaskKind @default(EVENT)
  skill  Skill?
  points Int      @default(10)

  // Смещения в минутах от Event.startsAt.
  // -1440 = «взять за сутки до», +1440 = «сдать через сутки после»
  claimByOffsetMin Int?
  dueAtOffsetMin   Int?

  packId String?
  pack   TemplatePack? @relation(fields: [packId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([packId])
}

// ============ СДАЧА И ПРИЁМКА ============

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Submission {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("submitter", fields: [authorId], references: [id])

  links   String[] // ссылки на результат: облако, пост, макет
  comment String?

  // Сдали медиа прямо в бота (мем, макет) — помним исходное сообщение,
  // чтобы переслать проверяющим через copyMessage, а не качать файл.
  tgChatId    BigInt?
  tgMessageId Int?

  status     ReviewStatus @default(PENDING)
  reviewerId String?
  reviewer   User?        @relation("reviewer", fields: [reviewerId], references: [id])
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([status])
}

// ============ ЖУРНАЛ И ОЧКИ ============

// История задачи: кто взял, кто бросил, когда протухла.
// Нужна и для аналитики, и чтобы разбирать спорные ситуации.
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String? // null — сделала сама система (например, протухание)
  actor     User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String // created | edited | published | claimed | released | unassigned | submitted | accepted | rejected | cancelled | expired | reopened
  meta      Json?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([type])
}

model PointEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  taskId    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============ ДОСТУП К АДМИНКЕ ============

// Вход без паролей: бот присылает одноразовую ссылку /auth/<code>.
// В базе только хэши — утёкшая база не даёт ни войти, ни угнать сессию.
model LoginCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============ БОТ ============

// Чего бот ждёт от человека следующим сообщением: ссылку на сдачу,
// комментарий к возврату. В памяти держать нельзя — tsx watch и деплой
// перезапускают процесс, и человек застрянет посреди сдачи.
model ChatState {
  telegramId BigInt   @id
  action     String // submit | reject_note
  payload    String // id квеста или сдачи
  expiresAt  DateTime
}

// Настройки, которые меняются из бота или админки без перезапуска.
// department_chat -> { chatId, threadId, title }
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
