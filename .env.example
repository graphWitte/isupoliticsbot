# ---- База ----
DATABASE_URL="postgresql://kvest:kvest@localhost:5433/kvest?schema=public"

# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=""

# ---- Доступ ----
# Telegram ID суперадминов через запятую. Всегда получают роль ADMIN,
# даже если роль поменяли в админке. Свой ID — команда /id в боте.
BOOTSTRAP_ADMIN_IDS=""

# ---- Админка ----
# Публичный адрес админки. Пока тут localhost, Telegram не даёт
# ставить на неё URL-кнопки — бот шлёт ссылки текстом.
# Домен должен совпадать с /setdomain у @BotFather — иначе не заработает
# кнопка «Войти через Telegram» (останется вход через /admin в боте).
APP_URL="http://localhost:3000"
# Часовой пояс отдела: в нём показываются и вводятся все дедлайны.
# Asia/Irkutsk — это UTC+8 круглый год (в России переходов на летнее время нет).
APP_TZ="Asia/Irkutsk"

# Чат отдела в .env НЕ задаётся: добавь бота в чат и напиши там /bind.
